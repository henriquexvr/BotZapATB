{
  "name": "atb-lol-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot que monitora partidas de LoL e gera roasts via Gemini",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop atb-lol-bot",
    "pm2:restart": "pm2 restart atb-lol-bot",
    "pm2:reload": "pm2 reload atb-lol-bot",
    "pm2:logs": "pm2 logs atb-lol-bot",
